@page "/products"
@model Samples.MinimalApis.Views.ProductList.ProductListModel

@{
    ViewData["Title"] = "Product List";
}

<link rel="stylesheet" href="/views/ProductList/ProductList.css" />

<h1 class="product-list__heading">Products</h1>

<table class="product-list__table">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < Model.Products.Length; i++)
        {
            <tr>
                <td>@(i + 1)</td>
                <td>@Model.Products[i]</td>
            </tr>
        }
    </tbody>
</table>

<script src="/views/ProductList/ProductList.js"></script>
